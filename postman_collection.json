          ]
        }
      },
      "response": []
    },
    {
      "name": "Webhook Verification (GET)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/webhook?hub.mode=subscribe&hub.challenge=123456&hub.verify_token={{WA_VERIFY_TOKEN}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "webhook"
          ],
          "query": [
            {
              "key": "hub.mode",
              "value": "subscribe"
            },
            {
              "key": "hub.challenge",
              "value": "123456"
            },
            {
              "key": "hub.verify_token",
              "value": "{{WA_VERIFY_TOKEN}}"
            }
          ]
        }
      },
      "response": [
        {
          "name": "Verification success",
          "originalRequest": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/webhook"
          },
          "status": "OK",
          "code": 200,
          "header": [
            {
              "key": "Content-Type",
              "value": "text/plain"
            }
          ],
          "body": "123456"
        }
      ]
    },
    {
      "name": "Webhook Incoming Message (POST)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/webhook",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "webhook"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"object\": \"whatsapp_business_account\",\n  \"entry\": [\n    {\n      \"id\": \"WHATSAPP_BUSINESS_ACCOUNT_ID\",\n      \"changes\": [\n        {\n          \"value\": {\n            \"messaging_product\": \"whatsapp\",\n            \"metadata\": {\n              \"display_phone_number\": \"1234567890\",\n              \"phone_number_id\": \"{{WA_PHONE_NUMBER_ID}}\"\n            },\n            \"contacts\": [\n              {\n                \"profile\": { \"name\": \"John Doe\" },\n                \"wa_id\": \"628123456789\"\n              }\n            ],\n            \"messages\": [\n              {\n                \"from\": \"628123456789\",\n                \"id\": \"ABGGFlA5FA1\",\n                \"timestamp\": \"1700000000\",\n                \"type\": \"text\",\n                \"text\": { \"body\": \"Halo bot!\" }\n              }\n            ]\n          },\n          \"field\": \"messages\"\n        }\n      ]\n    }\n  ]\n}"
        }
      },
      "response": [
        {
          "name": "Webhook accepted",
          "originalRequest": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/webhook"
          },
          "status": "OK",
          "code": 200,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{ \"status\": \"ok\" }"
        }
      ]
    },
